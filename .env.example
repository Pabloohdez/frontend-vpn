# ============================================================================
# fronted-vpn — Configuración del panel
#
# Copia este archivo a `.env` y rellena los valores REALES de tu entorno.
# `.env` está en `.gitignore` y NUNCA debe subirse al repositorio.
#
# Genera secretos aleatorios fuertes (32+ bytes) con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# --- API OpenVPN (VM1) --------------------------------------------------------
# Apunta al servidor donde corre la API de gestión de OpenVPN.
# Usa la IP/host privada de tu LAN o un FQDN interno. NO uses URL pública sin TLS.
VPN_API_BASE_URL=http://CAMBIA_HOST_VPN:PUERTO
VPN_API_KEY=CAMBIA_POR_TOKEN_LARGO_ALEATORIO

# Opcional: ruta para descargar bundle/perfil del usuario (.zip/.ovpn).
# Por defecto: /api/v1/admin/users/{cn}/bundle
# VPN_VM1_BUNDLE_PATH_TEMPLATE=

# --- Autenticación del panel --------------------------------------------------
# Obliga a configurar 2FA TOTP antes de usar el panel como admin (recomendado).
# Pon false solo en desarrollo / primer despliegue sin app 2FA.
ADMIN_2FA_REQUIRED=true
# SESSION_SECRET: mínimo 32 caracteres, único por entorno.
SESSION_SECRET=CAMBIA_POR_32_CARACTERES_ALEATORIOS_O_MAS

# Cookies de sesión: con HTTP plano detrás de proxy TLS pon false.
COOKIE_SECURE=false
# Si tienes proxy TLS delante que reenvía X-Forwarded-Proto: https.
# TRUST_PROXY=true

# Redis (recomendado para sesiones/lockout/ratelimit de producción)
# REDIS_URL=redis://:password@host:6379/0

# Clave maestra para cifrado en reposo (2FA secrets, logs firmados, etc.)
# Puede ser hex de 32 bytes (64 chars) o una passphrase (se deriva con SHA-256).
# MASTER_KEY=CAMBIA_POR_UNA_CLAVE_LARGA_ALEATORIA

# Auditoría crítica firmada (append-only). Por defecto junto a AUDIT_DB_PATH.
# AUDIT_SIGNED_PATH=/app/data/audit-critical.signed.jsonl

# Categorías (Pi-hole): almacenamiento local.
# CATEGORY_DB_PATH=/app/data/categories.json

# Usuarios del panel (opcional): el admin puede crear más cuentas en Ajustes → Usuarios del panel.
# PANEL_USERS_PATH=/app/data/panel-users.json

# Admin: contraseña en claro O hash PBKDF2 (no uses ambas a la vez).
# Login legacy con usuario fijo "admin" + esta contraseña, o cuenta creada en el panel.
# Formato PBKDF2: saltHex:iterations:keyHex (SHA-256, 32 bytes, iterations >= 100000)
# Generar (sustituye TU_CLAVE):
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const it=600000;const p='TU_CLAVE';const k=c.pbkdf2Sync(p,Buffer.from(s,'hex'),it,32,'sha256').toString('hex');console.log('ADMIN_PASSWORD_PBKDF2='+s+':'+it+':'+k)"
# ADMIN_PASSWORD_PBKDF2=
ADMIN_PASSWORD=CAMBIA_CONTRASENA_ADMIN

# Opcional: rol auditor (solo lectura).
# AUDITOR_PASSWORD_PBKDF2=
AUDITOR_PASSWORD=CAMBIA_CONTRASENA_AUDITOR

# Opcional: rol operador (puede operar Pi-hole/bloqueos/horarios, no OpenVPN).
# OPERATOR_PASSWORD_PBKDF2=
# OPERATOR_PASSWORD=CAMBIA_CONTRASENA_OPERADOR

# --- Auditoría ----------------------------------------------------------------
# Persistencia en JSONL dentro del volumen `data/` (no se commitea).
AUDIT_DB_PATH=/app/data/audit.jsonl
# Retención (días) del fichero de auditoría. Default 90.
# AUDIT_RETENTION_DAYS=90

# Alertas en /seguridad (logins fallidos en ventana de auditoría).
# SECURITY_ALERT_FAILED_LOGINS=5

# Detección de tunelización (heurísticas): umbral score (0-100)
# SECURITY_TUNNEL_SCORE_THRESHOLD=75

# --- Bloqueo de internet por cliente (Pi-hole v6) -----------------------------
# INTERNET_BLOCKS_PATH=/app/data/internet-blocks.json
# PIHOLE_INTERNET_BLOCK_GROUP_NAME=panel-internet-off
# PIHOLE_INTERNET_BLOCK_REGEX=(^|.+\\.)

# --- DNS (Pi-hole) ------------------------------------------------------------
# Base sin barra final. Acepta también con `/admin` (se normaliza para la API v6).
PIHOLE_BASE_URL=http://CAMBIA_HOST_PIHOLE:PUERTO
# v5: token API del dashboard. v6: contraseña de aplicación (Ajustes → Web/API).
# El hash antiguo de v5 NO sirve en v6.
PIHOLE_API_TOKEN=CAMBIA_POR_TOKEN_O_PASSWORD_DE_APP

# --- Inventario de red (netmonitor, opcional) ---------------------------------
# 1) Despliega la API: bash integrations/netmonitor/deploy.sh
# 2) En netmonitor-web (docker-compose): INTERNAL_API_KEY=una_clave_larga_aleatoria
# En Docker usa `host.docker.internal`. En el host sin Docker, la IP/host privada del servidor.
NETMONITOR_BASE_URL=http://host.docker.internal:PUERTO_NETMONITOR
NETMONITOR_API_KEY=MISMA_CLAVE_QUE_INTERNAL_API_KEY

# --- Logs y datos locales (opcional) ------------------------------------------
# LOG_LEVEL=info          # debug | info | warn | error
# LOG_PRETTY=1            # salida legible en desarrollo
# BLOCK_SCHEDULES_PATH=./data/block-schedules.json
# INTERNET_BLOCKS_PATH=./data/internet-blocks.json
